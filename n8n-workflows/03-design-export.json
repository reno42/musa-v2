{
  "name": "Futuraria - Design Export Pipeline",
  "nodes": [
    {
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "futuraria-export",
        "responseMode": "lastNode"
      },
      "typeVersion": 1
    },
    {
      "name": "Get Template",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "parameters": {
        "method": "GET",
        "url": "={{$env.FUTURARIA_API_URL}}/api/templates/{{$json.body.templateId}}",
        "headers": { "X-API-Key": "={{$env.FUTURARIA_API_KEY}}" },
        "responseFormat": "json"
      },
      "typeVersion": 4
    },
    {
      "name": "Request Export",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 300],
      "parameters": {
        "method": "POST",
        "url": "={{$env.FUTURARIA_API_URL}}/api/templates/{{$json.body.templateId}}/export",
        "headers": {
          "X-API-Key": "={{$env.FUTURARIA_API_KEY}}",
          "Content-Type": "application/json"
        },
        "body": {
          "format": "png",
          "scale": 2
        },
        "responseFormat": "json"
      },
      "typeVersion": 4
    },
    {
      "name": "Get SVG Export",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 500],
      "parameters": {
        "method": "GET",
        "url": "={{$env.FUTURARIA_API_URL}}/api/templates/{{$json.body.templateId}}/export/svg",
        "headers": { "X-API-Key": "={{$env.FUTURARIA_API_KEY}}" },
        "responseFormat": "text"
      },
      "typeVersion": 4
    },
    {
      "name": "Set Export Result",
      "type": "n8n-nodes-base.set",
      "position": [850, 300],
      "parameters": {
        "values": {
          "string": [
            { "name": "status", "value": "Export ready" },
            { "name": "exportId", "value": "={{$json.data.id}}" },
            { "name": "templateId", "value": "={{$json.data.templateId}}" },
            { "name": "format", "value": "={{$json.data.format}}" }
          ]
        }
      },
      "typeVersion": 1
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[
        { "node": "Get Template", "type": "main", "index": 0 }
      ]]
    },
    "Get Template": {
      "main": [[
        { "node": "Request Export", "type": "main", "index": 0 },
        { "node": "Get SVG Export", "type": "main", "index": 0 }
      ]]
    },
    "Request Export": {
      "main": [[{ "node": "Set Export Result", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
