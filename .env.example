# Futuraria Design Harness — Environment Variables
# Copy this file to .env and fill in your credentials.
# Without Supabase, the app uses in-memory storage (data lost on restart).

# ── Supabase (Data Persistence) ──────────────
# Get these from: https://app.supabase.com → Project Settings → API
# Free tier works perfectly. Leave blank for in-memory-only mode.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# Legacy names remain supported during migration:
# SUPABASE_SERVICE_KEY=legacy_service_role_or_secret_key
# SUPABASE_ANON_KEY=legacy_anon_key

# Browser authentication reads SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY at
# runtime. VITE_* is optional for build-time Realtime support; never expose
# SUPABASE_SECRET_KEY with a VITE_ prefix.
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# Encrypts BYOK/MCP credentials at rest. OPTIONAL — if omitted, the platform
# derives the encryption key from SUPABASE_SECRET_KEY so BYOK works out-of-the-box
# wherever Supabase is configured. Set this only if you want a dedicated secret
# separate from the database key. Keep it stable; changing it makes existing
# workspace credentials unreadable.
# WORKSPACE_SECRET_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Optional safety override for migrating designs created before SaaS accounts.
# If omitted, only the first and sole Supabase Auth user can claim legacy workspaces.
# SAAS_INITIAL_OWNER_EMAIL=owner@example.com

# ── Supabase PAT (for schema setup) ────────────
# Used by scripts/setup-supabase.mjs to create database tables.
# Get yours at: https://app.supabase.com/account/tokens
# Only needed once during initial setup.
# SUPABASE_PAT=sbp_xxxxxxxxxxxxxxxxxxxx

# ── Supabase Realtime (optional) ───────────────
# Enables real-time collaboration and agent presence.
# Only the VITE_* prefixed vars are exposed to the browser.
# ── API Key (for MCP access) ──────────────────
# Used by AI agents to authenticate MCP calls. Default: "dev-key"
# Global emergency/admin key. Normal AI access uses workspace-scoped keys
# created from the Workspace > APIs y MCPs screen.
# MCP_ADMIN_KEY=replace-with-a-long-random-admin-key

# ── Google Fonts (catálogo completo en el editor) ──
# Optional. Without it, /api/fonts/catalog serves only the built-in system
# fonts (the picker warns "Catálogo reducido — no response from Google").
# Free key: Google Cloud Console → enable "Web Fonts Developer API" →
# Credentials → Create API key. Put the real value in .env or api/.env
# (scripts/dev-all.mjs injects both into the API process; in production:
# netlify env:set GOOGLE_FONTS_API_KEY=...).
# GOOGLE_FONTS_API_KEY=your_key_here

# ── Netlify-specific fallbacks ─────────────────
# These are auto-set by Netlify if you use `netlify env:set`.
# Only needed if your Netlify env var names differ from above.
# SUPABASE_PROJECT_URL_DE_REPO_DESIGN=...
# SUPABASE_SECRET_KEY_DE_REPO_DESIGN=...
