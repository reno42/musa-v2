# Local Netlify folder
.netlify
public/SKILL.md

# Reference repos (not part of codebase)
ejemplo-harness-subagentes-main/

# Typecheck output
tsc-output.txt

# Throwaway captures agents drop in the repo root while verifying a change.
# The ones already committed under QA/ stay committed; this only stops new
# ones from piling up at the top level.
/screenshot_*.png
/slide*.png
/step*.png

# Assets uploaded to a local api server: with no Supabase configured it
# writes them to disk instead of Storage.
api/public/assets/

# 0-byte artefact of a `> nul` redirect written on Windows.
/nul

# ONNX weights cache for scripts/fetch-segment-models.mjs (uploaded to
# the ml-models Supabase bucket, never committed).
/models-cache/

# Router ONNX del ChatFAB (clasificador de intents, ~280MB): en dev se
# sirve desde public/, en prod vive en Cloudflare R2. NUNCA entra a git —
# los metadatos (tokenizer.json, labels.json) sí se commitean.
public/router/*.onnx

# Motor de imprenta (print export): gs.wasm 15MB + perfiles ICC —
# reproducibles via `npm run fetch:print-assets` (prebuild los regenera).
/public/assets/print-engine/

# Local package stores and scratch dirs — never part of the codebase.
/.pnpm-store/
/.tmp/

# LOCAL-ONLY (regla explícita del humano, 2026-09-12): la tabla de
# documentación de herramientas es el blueprint completo del producto —
# vive en disco para el deploy local y NUNCA se commitea ni pushea.
src/data/toolsDocumentation.ts
src/components/ToolsDocsSection.tsx
