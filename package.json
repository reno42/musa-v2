{
  "name": "@futuraria/editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:functions": "cd api && npm install && npx tsc"
  },
  "dependencies": {
    "@sparticuz/chromium": "106.0.0",
    "fabric": "^6.9.1",
    "puppeteer-core": "19.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "reactDoctor": {
    "ignore": {
      "files": ["node_modules/**", "dist/**", ".vite/**"],
      "rules": [
        "deslop/unused-file",
        "react-doctor/exhaustive-deps",
        "react-doctor/no-giant-component",
        "react-doctor/no-many-boolean-props"
      ]
    }
  }
}
