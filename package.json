{
  "name": "@futuraria/editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc && vite build",
    "test:regression": "node --experimental-strip-types --test QA/css-mutations.test.mjs QA/bezier-math.test.mjs QA/shape-paths.test.mjs QA/deck-generator.test.mjs",
    "test:editor": "node QA/editor-interactions/run.mjs",
    "preview": "vite preview",
    "build:functions": "cd api && npm install && npx tsc"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/dompurify": "^3.0.5",
    "cheerio": "^1.2.0",
    "dompurify": "^3.4.11",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg-path-commander": "^2.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "reactDoctor": {
    "ignore": {
      "files": [
        "node_modules/**",
        "dist/**",
        ".vite/**"
      ],
      "rules": [
        "deslop/unused-file",
        "react-doctor/exhaustive-deps",
        "react-doctor/no-giant-component",
        "react-doctor/no-many-boolean-props"
      ]
    }
  }
}
