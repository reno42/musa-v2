{
  "name": "@futuraria/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && esbuild ./src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.bundle.js",
    "start": "node dist/server.bundle.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "@types/dompurify": "^3.0.5",
    "cors": "^2.8.5",
    "dompurify": "^3.4.11",
    "express": "^4.21.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
