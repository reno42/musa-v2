<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI_ De idea a producto en 5 semanas - Bootca — Futuraria HTML Render</title>

<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 2160px;
    height: 2160px;
    overflow: hidden;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; } body { font-family: 'Inter', 'Segoe UI', system-ui, sans-serif; background: #08080c; display: flex; align-items: center; justify-content: center; width: 1080px; height: 1080px; overflow: hidden; } .post { width: 1080px; height: 1080px; background: linear-gradient(135deg, #08080c 0%, #0d1117 40%, #0a1628 100%); position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; } .bg-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(59,130,246,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,0.06) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 30%, transparent 70%); } .glow-orb { position: absolute; width: 500px; height: 500px; background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, transparent 70%); top: 50%; left: 50%; transform: translate(-50%, -50%); filter: blur(40px); } .logo { font-size: 18px; font-weight: 700; letter-spacing: 8px; color: rgba(255,255,255,0.4); text-transform: uppercase; position: absolute; top: 70px; z-index: 2; } .hero { font-size: 72px; font-weight: 800; color: #ffffff; letter-spacing: -2px; text-align: center; z-index: 2; line-height: 1.1; max-width: 800px; } .highlight { font-size: 72px; font-weight: 800; background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; letter-spacing: -2px; text-align: center; z-index: 2; line-height: 1.1; } .subtitle { font-size: 28px; font-weight: 400; color: rgba(255,255,255,0.7); margin-top: 32px; letter-spacing: 1px; z-index: 2; text-align: center; } .tagline { font-size: 16px; font-weight: 400; color: rgba(255,255,255,0.4); margin-top: 24px; z-index: 2; text-align: center; max-width: 600px; line-height: 1.6; } .accent-bar { width: 80px; height: 3px; background: linear-gradient(90deg, #3b82f6, #8b5cf6); margin-top: 40px; border-radius: 2px; z-index: 2; } .footer { font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.25); position: absolute; bottom: 60px; letter-spacing: 4px; z-index: 2; text-transform: uppercase; }
</style>
</head>
<body>
<div class="post">
  <div class="bg-grid"></div>
  <div class="glow-orb"></div>
  <div class="logo">FUTURARIA</div>
  <div class="hero">De idea a producto</div>
  <div class="highlight">en 5 semanas</div>
  <div class="subtitle">Bootcamp IA � Ciencia</div>
  <div class="tagline">37 modelos open-source. $0 en herramientas. Todo en Colab.</div>
  <div class="accent-bar"></div>
  <div class="footer">futuraria.com</div>
</div>
<script>
  // Auto-download PNG on load using SVG foreignObject
  // Waits for fonts to load before rendering
  (function() {
    var safeName = "AI_ De idea a producto en 5 semanas - Bootca";
    var format = "png";
    var width = 2160;
    var height = 2160;

    function doRender() {
      var canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      var ctx = canvas.getContext('2d');

      // Use SVG foreignObject to render HTML to canvas
      var data = '<svg xmlns="http://www.w3.org/2000/svg" width="' + width + '" height="' + height + '">' +
        '<foreignObject width="100%" height="100%">' +
        '<div xmlns="http://www.w3.org/1999/xhtml" style="width:' + width + 'px;height:' + height + 'px">' +
        document.documentElement.outerHTML.replace('<html', '<div').replace('</html>', '</div>') +
        '</div>' +
        '</foreignObject>' +
        '</svg>';

      var img = new Image();
      var svg = new Blob([data], { type: 'image/svg+xml;charset=utf-8' });
      var url = URL.createObjectURL(svg);

      img.onload = function() {
        ctx.drawImage(img, 0, 0);
        URL.revokeObjectURL(url);

        var mimeType = format === 'jpg' ? 'image/jpeg' : 'image/png';
        canvas.toBlob(function(blob) {
          var downloadUrl = URL.createObjectURL(blob);
          var a = document.createElement('a');
          a.href = downloadUrl;
          a.download = safeName + '.' + format;
          a.click();
          URL.revokeObjectURL(downloadUrl);

          // Show status bar
          var div = document.createElement('div');
          div.style.cssText = 'position:fixed;top:0;left:0;right:0;background:#fff;padding:12px;box-shadow:0 2px 8px rgba(0,0,0,0.2);z-index:9999;display:flex;gap:10px;font-family:sans-serif;align-items:center;';
          div.innerHTML = '<strong style="flex:1">' + safeName + ' — Rendered (' + format.toUpperCase() + ')</strong>' +
            '<button onclick="this.parentElement.remove()" style="border:none;background:none;cursor:pointer;font-size:18px">x</button>';
          document.body.prepend(div);
        }, mimeType);
      };

      img.src = url;
    }

    // Wait for Google Fonts to finish loading before rendering
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(doRender);
    } else {
      setTimeout(doRender, 800);
    }
  })();
</script>
</body></html>